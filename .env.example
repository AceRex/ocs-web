VITE_API_URL=/api

# Configure only signed, verified release artifacts. Missing links disable downloads.
VITE_RELEASE_VERSION=
VITE_MACOS_ARM64_DOWNLOAD_URL=
VITE_MACOS_INTEL_DOWNLOAD_URL=
VITE_WINDOWS_DOWNLOAD_URL=
VITE_MACOS_DOWNLOAD_SIZE=
VITE_WINDOWS_DOWNLOAD_SIZE=

# Public Web application OAuth client ID; must match backend GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=
